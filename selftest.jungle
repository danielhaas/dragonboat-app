# Overlay for the analyzer self-test build. Use together with
# monkey.jungle:
#   monkeyc -f "monkey.jungle;selftest.jungle" -d fenix6 -o bin/selftest.prg ...
# Includes (:selftest) code and its data (resources-selftest/, generated by
# extract_accel_blob.py) and drops the no-op (:noselftest) stubs.
base.resourcePath = resources;resources-selftest
base.excludeAnnotations = noselftest;replay
