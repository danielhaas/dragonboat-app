# Layer on top of monkey.jungle to build the simulator replay variant:
#   monkeyc -f "monkey.jungle;sim.jungle" ...
# Adds source-replay/ + resources-replay/ (generated by make_replay_data.py)
# and swaps the no-op replay hooks in DragonBoatView for the real ones.
base.sourcePath = source;source-replay
base.resourcePath = resources;resources-replay
base.excludeAnnotations = noreplay
