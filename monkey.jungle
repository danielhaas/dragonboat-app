project.manifest = manifest.xml

# Source files
base.sourcePath = source

# Resources
base.resourcePath = resources

# Test-only code is excluded from normal builds. Layer an overlay on top
# to include it:
#   monkeyc -f "monkey.jungle;sim.jungle" ...       simulator session replay
#   monkeyc -f "monkey.jungle;selftest.jungle" ...  analyzer self-test
base.excludeAnnotations = replay;selftest
